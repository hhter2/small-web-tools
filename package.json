{
  "name": "small-web-tools",
  "private": true,
  "version": "0.5.4-beta",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bundle:check": "node scripts/check-bundle.mjs",
    "headers:check": "node scripts/check-headers.mjs",
    "preview": "vite preview",
    "lint": "eslint src functions",
    "typecheck": "tsc --project jsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "deps:check": "knip --dependencies --no-progress",
    "audit": "npm audit --audit-level=moderate",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run build && npm run bundle:check && npm run headers:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "knip": "5.64",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "exifreader": "^4.41.0",
    "html5-qrcode": "^2.3.8",
    "ignore": "^7.0.6",
    "ipaddr.js": "^2.4.0",
    "jsbarcode": "^3.11.6",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
