{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "small-web-tools-rate-limiter",
  "main": "src/index.js",
  "compatibility_date": "2026-07-23",
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "EXPENSIVE_LIMITER",
      "namespace_id": "2026072301",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "STANDARD_LIMITER",
      "namespace_id": "2026072302",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
