{
  "name": "small-web-tools",
  "private": true,
  "version": "0.0.0-private",
  "packageManager": "npm@10.9.2",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bundle:check": "node scripts/check-bundle.mjs",
    "headers:check": "node scripts/check-headers.mjs",
    "external-hosts:check": "node scripts/check-external-hosts.mjs",
    "platform:check": "node scripts/check-cloudflare-config.mjs",
    "platform:integration": "node scripts/check-rate-limit-integration.mjs",
    "version:check": "node scripts/check-version.mjs",
    "preview": "vite preview",
    "lint": "eslint src functions workers test scripts e2e --max-warnings 68",
    "typecheck": "tsc --project jsconfig.json --noEmit",
    "typecheck:strict": "tsc --project jsconfig.strict.json --noEmit",
    "docs:check": "node scripts/check-doc-consistency.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:deployed": "playwright test e2e/deployed-headers.spec.js",
    "test:ssrf-runtime": "node scripts/verify-ssrf-cloudflare-runtime.mjs",
    "deps:check": "knip --dependencies --no-progress",
    "audit": "npm audit --audit-level=moderate",
    "verify": "npm run version:check && npm run lint && npm run typecheck && npm run typecheck:strict && npm run test:coverage && npm run build && npm run bundle:check && npm run headers:check && npm run external-hosts:check && npm run platform:check && npm run docs:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "knip": "5.64",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "esbuild": "^0.25.0",
    "minimatch": "10.2.5"
  },
  "knip": {
    "ignoreDependencies": [
      "wrangler"
    ]
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "exifreader": "^4.41.0",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "ignore": "^7.0.6",
    "ipaddr.js": "^2.4.0",
    "jsbarcode": "^3.11.6",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
